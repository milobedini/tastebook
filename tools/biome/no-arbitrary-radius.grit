language js

or {
  JsStringLiteralExpression(),
  JsxString(),
  JsTemplateChunkElement()
} as $s where {
  $s <: r".*rounded[-a-z]*-[\[(].*",
  register_diagnostic(span=$s, message="Use one of Picnic's corner tokens (rounded-pill, -sheet, -timer, -card, -note, -check, -row, -option, -blob-1, -blob-2, -blob-3), not an arbitrary radius.")
}
