{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["lhr1"],
  "services": {
    "frontend": {
      "root": "frontend",
      "ignoreCommand": "bash \"$(git rev-parse --show-toplevel)/tools/vercel/ignored-build-step.sh\"",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "backend": {
      "root": "backend",
      "ignoreCommand": "bash \"$(git rev-parse --show-toplevel)/tools/vercel/ignored-build-step.sh\"",
      "entrypoint": "config.wsgi:application"
    }
  },
  "rewrites": [
    {
      "source": "/monitoring",
      "destination": "https://o4512323379724288.ingest.de.sentry.io/api/4512323386015824/envelope/"
    },
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
